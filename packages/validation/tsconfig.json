{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@nati-lotto/shared-types": ["../shared-types/dist", "../shared-types/src"],
      "zod": ["node_modules/zod", "../../apps/api/node_modules/zod", "../../apps/web/node_modules/zod", "../../node_modules/zod"]
    }
  },
  "include": ["src/**/*"]
}
