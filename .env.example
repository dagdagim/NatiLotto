# ==========================================
# NATI LOTTO - Environment Configuration
# "Your Chance. Your Moment."
# ==========================================

# Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:DagimB@localhost:5432/NatiLotto?schema=public

# Redis (Cache, Throttling & WebSocket Pub/Sub)
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_SECRET=super-secret-nati-lotto-jwt-key-change-in-production-min32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3 Object Storage (MinIO / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=nati-lotto-prizes
STORAGE_REGION=us-east-1

# Development Mode
# WARNING: MOCK_MODE must never be true in production!
MOCK_MODE=true

# Payment Providers
PAYMENT_PROVIDER=MOCK
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_NOTIFY_URL=http://localhost:4000/api/v1/payments/webhook/telebirr

# Compliance & Responsible Gaming
COMPLIANCE_MIN_AGE=18
COMPLIANCE_MAX_DAILY_TICKETS_PER_USER=100
COMPLIANCE_MAX_TICKETS_PER_DRAW_PER_USER=25
COMPLIANCE_LICENSE_REGISTRATION_REQUIRED=true
COMPLIANCE_NATIONAL_LOTTERY_PERMIT_NO=NL-ET-2026-0892

# Notification Providers
SMS_PROVIDER=MOCK
EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mydeveloper444@gmail.com
SMTP_PASS=butvaazyizzyvaxx
SMTP_FROM=noreply@natilotto.et
{
  "ssh": "Disabled",
  "previewLimit": 50,
  "server": "localhost",
  "port": 5432,
  "driver": "PostgreSQL",
  "name": "NatiLotto",
  "database": "NatiLotto",
